{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "PostgreSQL disponível",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "pg_up", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "mappings": [{"type": "value", "value": "1", "text": "UP"}, {"type": "value", "value": "0", "text": "DOWN"}]}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "colorMode": "background"}
    },
    {
      "type": "timeseries",
      "title": "Conexões ativas",
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0},
      "targets": [{"expr": "pg_stat_database_numbackends{datname=\"dbops\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "Tamanho do banco",
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0},
      "targets": [{"expr": "pg_database_size_bytes{datname=\"dbops\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "Transações por segundo",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "rate(pg_stat_database_xact_commit{datname=\"dbops\"}[5m])", "refId": "A"}, {"expr": "rate(pg_stat_database_xact_rollback{datname=\"dbops\"}[5m])", "refId": "B"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "Deadlocks",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "increase(pg_stat_database_deadlocks{datname=\"dbops\"}[5m])", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "Queries ativas e idade máxima",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [{"expr": "dbops_activity_active_queries{datname=\"dbops\"}", "refId": "A"}, {"expr": "dbops_activity_max_query_age_seconds{datname=\"dbops\"}", "refId": "B"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "Sessões aguardando lock",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [{"expr": "dbops_lock_waits_blocked_queries{datname=\"dbops\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "Backups: idade, falha e duração",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {"expr": "dbops_backup_status_age_seconds{backup_type=\"logical\"}", "refId": "A"},
        {"expr": "dbops_backup_status_failed{backup_type=\"logical\"}", "refId": "B"},
        {"expr": "dbops_backup_status_duration_seconds{backup_type=\"logical\"}", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "CPU do host monitorado",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [{"expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "Memória disponível",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [{"expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["dbops", "postgresql"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "DBOps Lab — PostgreSQL Overview",
  "uid": "dbops-postgres",
  "version": 1
}
