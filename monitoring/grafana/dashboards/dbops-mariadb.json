{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "MariaDB disponível",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "mysql_up{job=\"mariadb\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "mappings": [{"type": "value", "value": "1", "text": "UP"}, {"type": "value", "value": "0", "text": "DOWN"}]}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "colorMode": "background"}
    },
    {
      "type": "timeseries",
      "title": "Conexões e threads ativos",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
      "targets": [{"expr": "mysql_global_status_threads_connected{job=\"mariadb\"}", "refId": "A"}, {"expr": "mysql_global_status_threads_running{job=\"mariadb\"}", "refId": "B"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "Queries lentas acumuladas",
      "gridPos": {"h": 8, "w": 12, "x": 18, "y": 0},
      "targets": [{"expr": "mysql_global_status_slow_queries{job=\"mariadb\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "Uptime do MariaDB",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "mysql_global_status_uptime{job=\"mariadb\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    },
    {
      "type": "timeseries",
      "title": "Temporárias em disco",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "mysql_global_status_created_tmp_disk_tables{job=\"mariadb\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["dbops", "mariadb"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "DBOps Lab — MariaDB Overview",
  "uid": "dbops-mariadb",
  "version": 1
}
