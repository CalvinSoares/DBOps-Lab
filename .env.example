# Nome do projeto Compose
COMPOSE_PROJECT_NAME=dbops_lab

# PostgreSQL — valores de laboratório; substitua apenas no .env local
POSTGRES_IMAGE=postgres:16.4-alpine
POSTGRES_DB=dbops
POSTGRES_USER=dbops_admin
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
POSTGRES_APP_USER=dbops_app
POSTGRES_APP_PASSWORD=change-me-app-locally
POSTGRES_OPERATOR_USER=dbops_operator
POSTGRES_OPERATOR_PASSWORD=change-me-operator-locally
POSTGRES_READONLY_USER=dbops_readonly
POSTGRES_READONLY_PASSWORD=change-me-readonly-locally
POSTGRES_MONITOR_USER=dbops_monitor
POSTGRES_MONITOR_PASSWORD=change-me-monitor-locally

# Caminho usado pelo health-check para verificar espaço local
DBOPS_DATA_PATH=.
DBOPS_MIN_FREE_MB=512
POSTGRES_BACKUP_DIR=postgres/backup/artifacts
POSTGRES_BACKUP_USER=dbops_backup
POSTGRES_BACKUP_PASSWORD=change-me-backup-locally
POSTGRES_PHYSICAL_BACKUP_DIR=postgres/backup/physical
# PITR usa o backup físico e os WALs locais para iniciar um cluster descartável

# Prometheus/Grafana — ativados nas fases de observabilidade
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
PROMETHEUS_PORT=9090
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.15.0
POSTGRES_EXPORTER_PORT=9187
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
NODE_EXPORTER_PORT=19100
GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally

# MariaDB — banco secundário ativado pelo profile secondary
MYSQL_IMAGE=mariadb:11.4.3
MYSQL_DATABASE=secondary_db
MYSQL_ROOT_PASSWORD=change-me-mariadb-root-locally
MYSQL_USER=dbops_mysql
MYSQL_PASSWORD=change-me-mariadb-locally
MYSQL_PORT=13306
MYSQL_BACKUP_DIR=mysql/backup

# Exporter MariaDB — usado com os profiles monitoring e secondary
MYSQL_EXPORTER_IMAGE=prom/mysqld-exporter:v0.15.1
MYSQL_EXPORTER_PORT=9188

# SQL Server — Windows/Developer ou Express para laboratório
SQLSERVER_INSTANCE=.\\SQLEXPRESS
SQLSERVER_DATABASE=DBOpsLabSqlServer
SQLSERVER_BACKUP_DIR=C:\\ProgramData\\DBOpsLab\\sqlserver-backups
SQLSERVER_RESTORE_DIR=C:\\ProgramData\\DBOpsLab\\sqlserver-restore
SQLSERVER_SQLCMD=sqlcmd
