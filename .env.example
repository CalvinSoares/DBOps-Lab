# Nome do projeto Compose
COMPOSE_PROJECT_NAME=dbops_lab

# PostgreSQL — valores de laboratório; substitua apenas no .env local
POSTGRES_IMAGE=postgres:16.4-alpine
POSTGRES_DB=dbops
POSTGRES_USER=dbops_admin
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Prometheus/Grafana — ativados nas fases de observabilidade
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
PROMETHEUS_PORT=9090
GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally
